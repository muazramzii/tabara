# Copy to `.env` and fill in. `.env` is git-ignored; this template is not.
#
# EXPO_PUBLIC_* variables are compiled INTO the app bundle and can be read by
# anyone who has the app. Only values that are safe to publish belong here.

# Supabase project URL (Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# The anon / publishable key. Safe to ship: Row Level Security is what protects
# the data. NEVER put the service_role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Secrets do NOT go in this file. The Gemini key is a Supabase secret:
#   npx supabase secrets set GEMINI_API_KEY=<your-key>
# and is read only inside the Edge Functions.
