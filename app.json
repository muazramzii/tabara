{
  "expo": {
    "name": "Tabara",
    "slug": "tabara",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/capy-chill.png",
    "scheme": "tabara",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/capy-chill.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F1E8",
        "foregroundImage": "./src/assets/capy-chill.png",
        "monochromeImage": "./src/assets/capy-chill.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.tabara"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/capy-chill.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F1E8",
          "image": "./src/assets/capy-chill.png",
          "imageWidth": 180
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
