# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — these hold secrets. Only the placeholder template
# (.env.example) is tracked; tests/repo-hygiene.test.ts enforces that.
.env
.env.*
!.env.example

# service credentials and signing material
*.keystore
service-account*.json
*-service-account*.json

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Supabase CLI local state. `supabase link` writes the hosted project's
# reference and name here; it is per-developer and must never be committed.
supabase/.temp/
supabase/.branches/
# Secrets for local Edge Function runs (`supabase functions serve --env-file`)
supabase/.env
supabase/.env.*
supabase/functions/.env
supabase/functions/.env.*

# Machine-specific Android SDK path
android/local.properties

